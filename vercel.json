{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/media/(.*)", "destination": "/api/index.py" },
    { "source": "/tts/(.*)", "destination": "/api/index.py" }
  ],
  "env": {
    "HL_OPEN_SOURCE": "1",
    "PYTHONIOENCODING": "utf-8"
  }
}
