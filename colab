    "#@title ▶ HL Studio GPU — bấm nút chạy ô này (lần đầu cài ~5–10 phút)\n",
    "# Vẽ ảnh: Z-Image-Turbo (Tongyi-MAI, Apache-2.0) · Nhạc: ACE-Step 1.5 (cho phép thương mại)\n",
    "# Chạy qua mã ComfyUI (GPL-3.0) ngay trong Colab, không mở giao diện web ra ngoài.\n",
    "CHO_TOI_DA_PHUT = 45  # không có việc mới quá số phút này thì tự dừng (đỡ tốn lượt GPU)\n",
    "\n",
    "import os, sys, json, time, glob, shutil, subprocess, urllib.request, urllib.error, random, traceback\n",
    "\n",
    "# ---------- 1) Google Drive ----------\n",
    "from google.colab import drive\n",
    "if not os.path.isdir('/content/drive/MyDrive'):\n",
    "    drive.mount('/content/drive')\n",
    "ROOT = '/content/drive/MyDrive/HL-Studio-Colab'\n",
    "VIEC, XONG = ROOT + '/viec', ROOT + '/xong'\n",
    "os.makedirs(VIEC, exist_ok=True); os.makedirs(XONG, exist_ok=True)\n",
    "print('📁 Thư mục việc:', ROOT)\n",
    "\n",
    "# ---------- 2) GPU ----------\n",
    "try:\n",
    "    gpu = subprocess.run(['nvidia-smi', '--query-gpu=name,memory.total', '--format=csv,noheader'], capture_output=True, text=True).stdout.strip()\n",
    "except FileNotFoundError:\n",
    "    gpu = ''\n",
    "if not gpu:\n",
    "    raise SystemExit('⚠ Chưa bật GPU. Menu Thời gian chạy (Runtime) → Thay đổi loại thời gian chạy → GPU T4 → Lưu, rồi chạy lại ô này.')\n",
    "print('🎮 GPU:', gpu)\n",
    "\n",
    "# ---------- 3) Cài ComfyUI (chỉ lần đầu mỗi phiên) ----------\n",
    "C = '/content/ComfyUI'\n",
    "if not os.path.isdir(C):\n",
    "    print('⏳ Đang cài bộ chạy mô hình (ComfyUI)…')\n",
    "    subprocess.run(['git', 'clone', '-q', '--depth', '1', 'https://github.com/comfyanonymous/ComfyUI', C], check=True)\n",
    "    subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', '-r', C + '/requirements.txt'], check=True)\n",
    "    subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', 'huggingface_hub'], check=True)\n",
    "\n",
    "from huggingface_hub import hf_hub_download\n",
    "\n",
    "MODELS = {\n",
    "    'anh': [('Comfy-Org/z_image_turbo', 'split_files/diffusion_models/z_image_turbo_bf16.safetensors', 'diffusion_models'),\n",
    "            ('Comfy-Org/z_image_turbo', 'split_files/text_encoders/qwen_3_4b.safetensors', 'text_encoders'),\n",
    "            ('Comfy-Org/z_image_turbo', 'split_files/vae/ae.safetensors', 'vae')],\n",
    "    'nhac': [('Comfy-Org/ace_step_1.5_ComfyUI_files', 'split_files/diffusion_models/acestep_v1.5_turbo.safetensors', 'diffusion_models'),\n",
    "             ('Comfy-Org/ace_step_1.5_ComfyUI_files', 'split_files/text_encoders/qwen_0.6b_ace15.safetensors', 'text_encoders'),\n",
    "             ('Comfy-Org/ace_step_1.5_ComfyUI_files', 'split_files/text_encoders/qwen_1.7b_ace15.safetensors', 'text_encoders'),\n",
    "             ('Comfy-Org/ace_step_1.5_ComfyUI_files', 'split_files/vae/ace_1.5_vae.safetensors', 'vae')],\n",
    "}\n",
    "MODELS['studio'] = MODELS['anh']\n",
    "_ready = set()\n",
    "\n",
    "\n",
    "def ensure_models(kind):\n",
    "    if kind in _ready:\n",
    "        return\n",
    "    for repo, path, folder in MODELS[kind]:\n",
    "        dst = f'{C}/models/{folder}/{os.path.basename(path)}'\n",
    "        if not os.path.exists(dst):\n",
    "            print(f'⏳ Tải mô hình {os.path.basename(path)} (lần đầu mỗi phiên)…')\n",
    "            f = hf_hub_download(repo, path, local_dir='/content/hf')\n",
    "            os.makedirs(os.path.dirname(dst), exist_ok=True)\n",
    "            shutil.move(f, dst)\n",
    "    _ready.add(kind)\n",
    "\n",
    "\n",
    "# ---------- 4) Chạy ComfyUI nền (chỉ trong máy Colab, cổng nội bộ) ----------\n",
    "API = 'http://127.0.0.1:8188'\n",
    "\n",
    "\n",
    "def api(path, data=None, timeout=30):\n",
    "    req = urllib.request.Request(API + path, data=json.dumps(data).encode() if data is not None else None,\n",
    "                                 headers={'Content-Type': 'application/json'})\n",
    "    with urllib.request.urlopen(req, timeout=timeout) as r:\n",
    "        return json.loads(r.read() or b'{}')\n",
    "\n",
    "\n",
    "def comfy_up():\n",
    "    try:\n",
    "        api('/system_stats', timeout=3)\n",
    "        return True\n",
    "    except Exception:\n",
    "        return False\n",
    "\n",
    "\n",
    "_proc = None\n",
    "\n",
    "\n",
    "def start_comfy():\n",
    "    global _proc\n",
    "    if comfy_up():\n",
    "        return\n",
    "    log = open('/content/comfy.log', 'a')\n",
    "    _proc = subprocess.Popen([sys.executable, 'main.py', '--listen', '127.0.0.1', '--port', '8188', '--disable-auto-launch'],\n",
    "                             cwd=C, stdout=log, stderr=subprocess.STDOUT)\n",
    "    for _ in range(240):\n",
    "        if comfy_up():\n",
    "            print('✅ Bộ chạy mô hình đã sẵn sàng')\n",
    "            return\n",
    "        if _proc.poll() is not None:\n",
    "            break\n",
    "        time.sleep(1)\n",
    "    raise RuntimeError('ComfyUI không khởi động được — xem /content/comfy.log')\n",
    "\n",
    "\n",
    "def run_graph(graph, label, timeout=1800):\n",
    "    pid = api('/prompt', {'prompt': graph})['prompt_id']\n",
    "    t0 = time.time()\n",
    "    while time.time() - t0 < timeout:\n",
    "        time.sleep(3)\n",
    "        h = api('/history/' + pid).get(pid)\n",
    "        if not h:\n",
    "            continue\n",
    "        st = h.get('status', {})\n",
    "        if st.get('status_str') == 'error':\n",
    "            msgs = [m for m in st.get('messages', []) if m and m[0] == 'execution_error']\n",
    "            raise RuntimeError((msgs[0][1].get('exception_message') if msgs else 'lỗi') + f' ({label})')\n",
    "        if st.get('completed') or h.get('outputs'):\n",
    "            files = []\n",
    "            for out in h.get('outputs', {}).values():\n",
    "                for k in ('images', 'audio'):\n",
    "                    for it in out.get(k, []):\n",
    "                        files.append(os.path.join(C, 'output', it.get('subfolder', ''), it['filename']))\n",
    "            return files\n",
    "    raise RuntimeError('Quá lâu không xong: ' + label)\n",
    "\n",
    "\n",
    "# ---------- 5) Đồ thị vẽ ảnh & nhạc (theo mẫu chính thức của ComfyUI) ----------\n",
    "SIZES = {'9:16': (720, 1280), '1:1': (1024, 1024), '16:9': (1280, 720), '4:5': (896, 1120)}\n",
    "\n",
    "\n",
    "def graph_image(prompt, w, h, seed, prefix):\n",
    "    return {\n",
    "        '1': {'class_type': 'UNETLoader', 'inputs': {'unet_name': 'z_image_turbo_bf16.safetensors', 'weight_dtype': 'fp8_e4m3fn'}},\n",
    "        '2': {'class_type': 'CLIPLoader', 'inputs': {'clip_name': 'qwen_3_4b.safetensors', 'type': 'lumina2'}},\n",
    "        '3': {'class_type': 'VAELoader', 'inputs': {'vae_name': 'ae.safetensors'}},\n",
    "        '4': {'class_type': 'ModelSamplingAuraFlow', 'inputs': {'model': ['1', 0], 'shift': 3.0}},\n",
    "        '5': {'class_type': 'CLIPTextEncode', 'inputs': {'clip': ['2', 0], 'text': prompt}},\n",
    "        '6': {'class_type': 'ConditioningZeroOut', 'inputs': {'conditioning': ['5', 0]}},\n",
    "        '7': {'class_type': 'EmptySD3LatentImage', 'inputs': {'width': w, 'height': h, 'batch_size': 1}},\n",
    "        '8': {'class_type': 'KSampler', 'inputs': {'model': ['4', 0], 'positive': ['5', 0], 'negative': ['6', 0], 'latent_image': ['7', 0],\n",
    "                                                    'seed': seed, 'steps': 8, 'cfg': 1.0, 'sampler_name': 'res_multistep', 'scheduler': 'simple', 'denoise': 1.0}},\n",
    "        '9': {'class_type': 'VAEDecode', 'inputs': {'samples': ['8', 0], 'vae': ['3', 0]}},\n",
    "        '10': {'class_type': 'SaveImage', 'inputs': {'images': ['9', 0], 'filename_prefix': prefix}},\n",
    "    }\n",
    "\n",
    "\n",
    "def graph_img2img(prompt, img_name, seed, prefix, denoise=0.3):\n",
    "    g = graph_image(prompt, 64, 64, seed, prefix)\n",
    "    g['7'] = {'class_type': 'VAEEncode', 'inputs': {'pixels': ['11', 0], 'vae': ['3', 0]}}\n",
    "    g['11'] = {'class_type': 'LoadImage', 'inputs': {'image': img_name}}\n",
    "    g['8']['inputs']['denoise'] = denoise\n",
    "    return g\n",
    "\n",
    "\n",
    "def graph_music(tags, lyrics, secs, bpm, lang, seed, prefix):\n",
    "    return {\n",
    "        '1': {'class_type': 'UNETLoader', 'inputs': {'unet_name': 'acestep_v1.5_turbo.safetensors', 'weight_dtype': 'default'}},\n",
    "        '2': {'class_type': 'DualCLIPLoader', 'inputs': {'clip_name1': 'qwen_0.6b_ace15.safetensors', 'clip_name2': 'qwen_1.7b_ace15.safetensors', 'type': 'ace'}},\n",
    "        '3': {'class_type': 'VAELoader', 'inputs': {'vae_name': 'ace_1.5_vae.safetensors'}},\n",
    "        '4': {'class_type': 'ModelSamplingAuraFlow', 'inputs': {'model': ['1', 0], 'shift': 3.0}},\n",
    "        '5': {'class_type': 'TextEncodeAceStepAudio1.5', 'inputs': {'clip': ['2', 0], 'tags': tags, 'lyrics': lyrics, 'seed': seed, 'bpm': bpm,\n",
    "              'duration': float(secs), 'timesignature': '4', 'language': lang, 'keyscale': 'C major', 'generate_audio_codes': True,\n",
    "              'cfg_scale': 2.0, 'temperature': 0.85, 'top_p': 0.9, 'top_k': 0, 'min_p': 0.0}},\n",
    "        '6': {'class_type': 'ConditioningZeroOut', 'inputs': {'conditioning': ['5', 0]}},\n",
    "        '7': {'class_type': 'EmptyAceStep1.5LatentAudio', 'inputs': {'seconds': float(secs), 'batch_size': 1}},\n",
    "        '8': {'class_type': 'KSampler', 'inputs': {'model': ['4', 0], 'positive': ['5', 0], 'negative': ['6', 0], 'latent_image': ['7', 0],\n",
    "                                                    'seed': seed, 'steps': 8, 'cfg': 1.0, 'sampler_name': 'euler', 'scheduler': 'simple', 'denoise': 1.0}},\n",
    "        '9': {'class_type': 'VAEDecodeAudio', 'inputs': {'samples': ['8', 0], 'vae': ['3', 0]}},\n",
    "        '10': {'class_type': 'SaveAudioMP3', 'inputs': {'audio': ['9', 0], 'filename_prefix': prefix, 'quality': 'V0'}},\n",
    "    }\n",
    "\n",
    "\n",
    "# ---------- 6) Làm việc ----------\n",
    "def note(out, text):\n",
    "    with open(out + '/dang.txt', 'w', encoding='utf-8') as f:\n",
    "        f.write(text)\n",
    "\n",
    "\n",
    "def compose(bg, prod, ratio):\n",
    "    \"\"\"Đặt sản phẩm (PNG nền trong) lên bối cảnh + bóng đổ mềm. Trả (ảnh ghép, mặt nạ sản phẩm).\"\"\"\n",
    "    from PIL import Image, ImageFilter, ImageDraw\n",
    "    W, H = bg.size\n",
    "    prod = prod.convert('RGBA')\n",
    "    bb = prod.getchannel('A').point(lambda v: 255 if v > 10 else 0).getbbox()\n",
    "    if bb:\n",
    "        prod = prod.crop(bb)\n",
    "    hr = {'9:16': 0.50, '1:1': 0.58, '4:5': 0.55, '16:9': 0.62}.get(ratio, 0.55)\n",
    "    k = min(H * hr / prod.height, W * 0.72 / prod.width)\n",
    "    prod = prod.resize((max(1, int(prod.width * k)), max(1, int(prod.height * k))), Image.LANCZOS)\n",
    "    pw, ph = prod.size\n",
    "    x, y = (W - pw) // 2, int(H * 0.86) - ph\n",
    "    a = prod.getchannel('A')\n",
    "    sh = Image.new('L', (W, H), 0)\n",
    "    d = ImageDraw.Draw(sh)\n",
    "    d.ellipse((x + pw * 0.08, y + ph - pw * 0.06, x + pw * 0.92, y + ph + pw * 0.07), fill=150)\n",
    "    sh = sh.filter(ImageFilter.GaussianBlur(max(4, pw * 0.04)))\n",
    "    drop = Image.new('L', (W, H), 0)\n",
    "    drop.paste(a.point(lambda v: v * 0.45), (x + int(pw * 0.03), y + int(ph * 0.02)))\n",
    "    import numpy as np\n",
    "    drop = drop.filter(ImageFilter.GaussianBlur(max(6, pw * 0.05)))\n",
    "    sh = Image.fromarray(np.maximum(np.asarray(sh), np.asarray(drop)))\n",
    "    comp = bg.convert('RGB').copy()\n",
    "    comp.paste(Image.new('RGB', (W, H), (0, 0, 0)), (0, 0), sh.point(lambda v: int(v * 0.75)))\n",
    "    comp.paste(prod, (x, y), a)\n",
    "    m = Image.new('L', (W, H), 0)\n",
    "    m.paste(a, (x, y))\n",
    "    return comp, m\n",
    "\n",
    "\n",
    "def do_studio(job, out):\n",
    "    from PIL import Image, ImageFilter, ImageChops\n",
    "    w, h = SIZES.get(job.get('tile'), SIZES['9:16'])\n",
    "    scene = job['boi_canh'] + (', ' + job['them'] if job.get('them') else '')\n",
    "    bgp = (scene + '. Empty clear surface in the lower center foreground for placing a product, no products, no people, no text, '\n",
    "           'professional commercial product photography backdrop, soft natural lighting, shallow depth of field, photorealistic, high detail')\n",
    "    hp = scene + '. A product standing on the surface in the center, professional commercial product photography, realistic soft shadows and reflections, photorealistic'\n",
    "    os.makedirs(C + '/input', exist_ok=True)\n",
    "    total = len(job['sp']) * int(job.get('so', 1))\n",
    "    made, n = [], 0\n",
    "    for i, spf in enumerate(job['sp'], 1):\n",
    "        prod = Image.open(f'{VIEC}/{spf}')\n",
    "        for k in range(int(job.get('so', 1))):\n",
    "            n += 1\n",
    "            note(out, f'Đang dựng ảnh studio {n}/{total}: vẽ bối cảnh…')\n",
    "            t0 = time.time()\n",
    "            bgf = run_graph(graph_image(bgp, w, h, random.randint(1, 2**31), f'hl/{job[\"id\"]}_bg{i}_{k}'), f'bối cảnh {n}')[0]\n",
    "            comp, mask = compose(Image.open(bgf), prod, job.get('tile'))\n",
    "            name = f'{job[\"id\"]}_ghep{i}_{k}.png'\n",
    "            comp.save(f'{C}/input/{name}')\n",
    "            note(out, f'Đang dựng ảnh studio {n}/{total}: hoà ánh sáng…')\n",
    "            hf = run_graph(graph_img2img(hp, name, random.randint(1, 2**31), f'hl/{job[\"id\"]}_hh{i}_{k}', 0.3), f'hoà sáng {n}')[0]\n",
    "            har = Image.open(hf).convert('RGB').resize(comp.size)\n",
    "            # giữ nguyên chi tiết sản phẩm (chữ, logo): dán lại sản phẩm gốc, chỉ nhận 25% ánh sáng/màu của bối cảnh\n",
    "            pm = mask.filter(ImageFilter.MinFilter(3)).filter(ImageFilter.GaussianBlur(1.2))\n",
    "            mixed = Image.blend(comp, har, 0.25)\n",
    "            final = Image.composite(mixed, har, pm)\n",
    "            dst = f'{out}/studio_{i:02d}_{k+1}.png'\n",
    "            final.save(dst); made.append(os.path.basename(dst))\n",
    "            print(f'   📸 ảnh studio {n}/{total} xong ({time.time()-t0:.0f}s)')\n",
    "    return made\n",
    "\n",
    "\n",
    "_wh = {}\n",
    "\n",
    "\n",
    "def do_nghe(job, out):\n",
    "    note(out, 'Đang cài Whisper…')\n",
    "    try:\n",
    "        import faster_whisper  # noqa\n",
    "    except ImportError:\n",
    "        subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', 'faster-whisper'], check=True)\n",
    "    from faster_whisper import WhisperModel\n",
    "    if 'm' not in _wh:\n",
    "        note(out, 'Đang nạp Whisper large-v3-turbo…')\n",
    "        try:\n",
    "            _wh['m'] = WhisperModel('large-v3-turbo', device='cuda', compute_type='float16')\n",
    "        except Exception as e:\n",
    "            print('⚠ GPU Whisper lỗi, dùng CPU:', e)\n",
    "            _wh['m'] = WhisperModel('large-v3-turbo', device='cpu', compute_type='int8')\n",
    "    segs, info = _wh['m'].transcribe(f'{VIEC}/{job[\"audio\"]}', language=job.get('ngon_ngu', 'vi'), word_timestamps=True, vad_filter=True, beam_size=5)\n",
    "    res, last = [], 0\n",
    "    for s in segs:\n",
    "        res.append({'start': round(s.start, 2), 'end': round(s.end, 2), 'text': s.text.strip(),\n",
    "                    'words': [{'s': round(w.start, 2), 'e': round(w.end, 2), 'w': w.word.strip()} for w in (s.words or [])]})\n",
    "        if s.end - last > 60:\n",
    "            last = s.end\n",
    "            note(out, f'Đang nghe: {s.end/60:.0f}/{info.duration/60:.0f} phút')\n",
    "    with open(out + '/loi-thoai.json', 'w', encoding='utf-8') as f:\n",
    "        json.dump({'segments': res}, f, ensure_ascii=False)\n",
    "    print(f'   👂 nghe xong {len(res)} câu')\n",
    "    return ['loi-thoai.json']\n",
    "\n",
    "\n",
    "def do_job(job):\n",
    "    jid, kind = job['id'], job['loai']\n",
    "    out = f'{XONG}/{jid}'\n",
    "    os.makedirs(out, exist_ok=True)\n",
    "    made = []\n",
    "    if kind == 'nghe':\n",
    "        made = do_nghe(job, out)\n",
    "    else:\n",
    "        note(out, 'Đang chuẩn bị mô hình…')\n",
    "        ensure_models(kind)\n",
    "        start_comfy()\n",
    "    if kind == 'studio':\n",
    "        made = do_studio(job, out)\n",
    "    elif kind == 'anh':\n",
    "        w, h = SIZES.get(job.get('tile'), SIZES['9:16'])\n",
    "        tasks = [(i, k, it['prompt']) for i, it in enumerate(job['ds']) for k in range(int(it.get('so', 1)))]\n",
    "        for n, (i, k, p) in enumerate(tasks, 1):\n",
    "            note(out, f'Đang vẽ ảnh {n}/{len(tasks)}…')\n",
    "            t0 = time.time()\n",
    "            for f in run_graph(graph_image(p, w, h, random.randint(1, 2**31), f'hl/{jid}_{i+1:02d}_{k+1}'), f'ảnh {n}'):\n",
